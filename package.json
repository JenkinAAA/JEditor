{
  "name": "@jenkin-a/jeditor",
  "version": "1.2.1",
  "description": "Hybrid rich-text and source HTML editor with high-fidelity preservation.",
  "type": "module",
  "main": "dist/jeditor.umd.js",
  "module": "dist/jeditor.es.js",
  "unpkg": "dist/jeditor.iife.js",
  "jsdelivr": "dist/jeditor.iife.js",
  "style": "dist/jeditor.css",
  "exports": {
    ".": {
      "import": "./dist/jeditor.es.js",
      "require": "./dist/jeditor.umd.js"
    },
    "./dist/jeditor.css": "./dist/jeditor.css",
    "./dist/jeditor.iife.js": "./dist/jeditor.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JenkinAAA/JEditor.git"
  },
  "homepage": "https://github.com/JenkinAAA/JEditor#readme",
  "bugs": {
    "url": "https://github.com/JenkinAAA/JEditor/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.browser.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "editor",
    "rich-text",
    "tiptap",
    "wysiwyg",
    "html-editor",
    "source-editor",
    "html-preservation",
    "wysiwyg-html"
  ],
  "author": "jenkin",
  "license": "MIT",
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-code-block-lowlight": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "lowlight": "^3.3.0",
    "prettier": "^3.8.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
